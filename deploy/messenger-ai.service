[Unit]
Description=Messenger personal AI reply bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/messenger-ai-bot
ExecStart=%h/messenger-ai-bot/.venv/bin/python -m messenger_ai run --live
Environment=PYTHONUNBUFFERED=1
UMask=0077
Restart=on-abnormal
RestartSec=15
TimeoutStopSec=60
KillSignal=SIGINT
NoNewPrivileges=true

[Install]
WantedBy=default.target
