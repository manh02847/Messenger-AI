diff --git a/bridge-e2ee/bridge/reaction_timestamp_test.go b/bridge-e2ee/bridge/reaction_timestamp_test.go
new file mode 100644
index 0000000..9744fbb
--- /dev/null
+++ b/bridge-e2ee/bridge/reaction_timestamp_test.go
@@ -0,0 +1,35 @@
+package bridge
+
+import (
+	"testing"
+
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/proto/waConsumerApplication"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestE2EEReactionCarriesSenderTimestampAcrossWire(t *testing.T) {
+	for _, emoji := range []string{"👍", "❤", ""} {
+		t.Run(emoji, func(t *testing.T) {
+			key := &waCommon.MessageKey{}
+			const timestampMS int64 = 1800000000123
+			message := buildE2EEReaction(key, emoji, timestampMS)
+			reaction := message.GetPayload().GetContent().GetReactionMessage()
+			if reaction.GetKey() != key || reaction.GetText() != emoji || reaction.GetSenderTimestampMS() != timestampMS {
+				t.Fatal("reaction lost its target, emoji or ordering timestamp")
+			}
+			wire, err := proto.Marshal(message)
+			if err != nil {
+				t.Fatal(err)
+			}
+			decoded := &waConsumerApplication.ConsumerApplication{}
+			if err = proto.Unmarshal(wire, decoded); err != nil {
+				t.Fatal(err)
+			}
+			got := decoded.GetPayload().GetContent().GetReactionMessage()
+			if got.GetKey() == nil || got.GetText() != emoji || got.GetSenderTimestampMS() != timestampMS {
+				t.Fatal("reaction timestamp missing from protobuf wire payload")
+			}
+		})
+	}
+}
