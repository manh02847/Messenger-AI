{
  "manifest_version": 3,
  "name": "Messenger AI — Call Lab",
  "version": "0.2.0",
  "description": "Gemini Live cho cuộc gọi Messenger, bật thủ công hoặc tự nhận theo lựa chọn.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://www.facebook.com/*", "https://web.facebook.com/*", "https://www.messenger.com/*", "https://messenger.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Messenger AI Call Lab"},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* ws://localhost:*"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*", "https://www.messenger.com/*", "https://messenger.com/*"],
      "js": ["pcm.js", "bridge-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*", "https://www.messenger.com/*", "https://messenger.com/*"],
      "js": ["incoming.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
