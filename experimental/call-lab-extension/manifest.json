{
  "manifest_version": 3,
  "name": "Messenger AI — Call Lab",
  "version": "0.1.0",
  "description": "Thử nối một cuộc gọi đã nhận thủ công với Gemini Live qua relay riêng.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Messenger AI Call Lab"},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* ws://localhost:*"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*", "https://www.messenger.com/*", "https://messenger.com/*"],
      "js": ["pcm.js", "bridge-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*", "https://www.messenger.com/*", "https://messenger.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
